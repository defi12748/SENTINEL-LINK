# ==============================================================================
# SENTINEL-LINK: Root .gitignore
# ==============================================================================

# User instruction: Do NOT include the skills folder
skills/
SKILL.md

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
env/
venv/

# Node & Next.js build artifacts
node_modules/
.next/
out/
.env
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE temporary files
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Raw SatNOGS audio is re-downloadable and SHA-256-verified against
# grss/data/satnogs/<norad>/manifest.json (`py -m sentinel fetch`).
grss/data/satnogs/*/obs_*/audio.ogg
# Attacked-recording decode cache (regenerated by train/bench)
grss/data/attacked/
# Demo station signing key and per-run ledgers (generated locally)
grss/results/station_ed25519.pem
grss/results/ledgers/

# Reference UI clone (not part of this project)
grss/frontend/sentinel/

# Rebuildable API analysis cache
grss/results/api-cache/
grss/results/survey-cache/

# Runtime output of the NASA modules (OnAIR log, CryptoLib security-association file)
grss/log.txt
grss/sa_save_file.bin
